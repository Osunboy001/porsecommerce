# MongoDB Atlas connection string, including the database name
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# Port for the Node API
PORT=4000

# Public URL of the React storefront (used for Stripe redirects + CORS)
WEB_URL="http://localhost:5173"

# Payment provider. Leave STRIPE_SECRET_KEY empty to use the built-in demo checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Protects admin endpoints (x-admin-key header). Leave empty to disable admin routes.
ADMIN_API_KEY="change-me-before-deploying"

# Secret used to sign admin JWTs (required)
JWT_SECRET="replace-with-a-long-random-secret"

# Optional seed account for first admin (a random password is printed if omitted)
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD=""
