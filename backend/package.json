{
  "name": "@porse/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "build": "node --check server.js && node --check app.js && node --check prisma/seed.js",
    "start": "node server.js",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "postinstall": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "stripe": "^17.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  }
}
